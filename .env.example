# Proyecto Supabase: nuestros-viajes (compartido con polla-app y viajes-app)
# Schema propio: eventos · Bucket propio: baul-eventos

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PROJECT_REF=TU_PROYECTO

# Contraseña de Postgres (Project Settings > Database). NO es una API key.
# Con esto corren el DDL, la siembra y toda la lectura y escritura de la app.
SUPABASE_DB_PASSWORD=

# Solo para Storage: subir y ver los archivos del baúl.
# Project Settings > API Keys > secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Acceso a la app, sin login. Se abre una vez /entrar?k=ESTE_VALOR y queda
# cookie httpOnly. Genera uno con:  node -e "console.log(crypto.randomUUID())"
ACCESO_SECRETO=

# Carpeta donde están las boletas ya descargadas, para el seed
DIR_BOLETAS=D:\Download

# Opcionales: la app deduce host y puerto del pooler según el entorno
# SUPABASE_DB_HOST=aws-1-us-east-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
